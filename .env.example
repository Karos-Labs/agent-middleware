# Application
APP_NAME=agent-middleware
ENVIRONMENT=local
LOG_LEVEL=INFO

# Google Cloud / Pub/Sub
GCP_PROJECT_ID=karoscmo-prep

# The one topic this service publishes to: agent-engine's run-jobs topic.
#   prep -> karos-agent-runs-prep
#   prod -> karos-agent-runs-prod
PUBSUB_JOB_TOPIC_ID=karos-agent-runs-prep

# Set to talk to a local Pub/Sub emulator instead of real GCP, e.g. localhost:8085
PUBSUB_EMULATOR_HOST=

PUBLISH_TIMEOUT_SECONDS=10

# --- Service-to-service authentication ---------------------------------------
# Verify the caller on every non-health route. Keep true everywhere but local.
AUTH_ENABLED=true

# This service's own Cloud Run URL — the 'aud' an inbound OIDC token must carry.
# REQUIRED when AUTH_ENABLED=true and no dev token is set. Without it the
# service refuses to verify tokens at all (a token with no audience bound to
# this service proves nothing; see app/security.py).
AUTH_AUDIENCE=

# Optional allowlist of caller service accounts, comma-separated JSON list, e.g.
# ["portal@karoscmo.iam.gserviceaccount.com"]. Empty admits any Google-verified
# identity, which is only safe behind Cloud Run IAM (roles/run.invoker).
AUTH_ALLOWED_SERVICE_ACCOUNTS=[]

# Static bearer token for local dev / integration tests. IGNORED when
# ENVIRONMENT=production, so leaving one set on a prod deploy is not a bypass.
AUTH_DEV_TOKEN=

# --- Authorization: who may do what ------------------------------------------
# Caller principal -> role, as a JSON object keyed by service-account email.
# The principal is the caller's `email` claim, or its `sub` when Google issued a
# token without one. Roles are ordered viewer < editor < admin:
#
#   viewer  every GET
#   editor  create, update, publish, dispatch -- the day-to-day
#   admin   anything that removes or resurrects a record, or changes whether an
#           agent may run at all (DELETE, restore, an agent's status)
#
# e.g. {"portal@karoscmo.iam.gserviceaccount.com":"editor",
#       "studio@karoscmo.iam.gserviceaccount.com":"admin"}
AUTH_ROLE_BINDINGS={}

# Role for a verified caller with no entry above. Defaults to `viewer`, so
# forgetting a binding refuses a write and names the principal in the 403 --
# rather than granting everything and saying nothing.
#
# READ THIS BEFORE FLIPPING AUTH_ENABLED TO TRUE (SCRUM-331): with auth off,
# every caller is the anonymous identity and holds admin, so role enforcement
# is inert. Turning authentication on turns authorization on in the same step.
# Bind the calling service accounts FIRST, or set AUTH_DEFAULT_ROLE=editor as a
# deliberate, temporary migration step and narrow it afterwards. The service
# logs an error at startup when auth is enabled and nothing is bound.
AUTH_DEFAULT_ROLE=viewer

# Firebase / Firestore (control plane store)
# Defaults to GCP_PROJECT_ID when empty.
FIRESTORE_PROJECT_ID=karoscmo
#   prep -> prep       prod -> (default)
FIRESTORE_DATABASE=prep
# Prefix every root collection, e.g. dev_ - lets environments share one database
FIRESTORE_COLLECTION_PREFIX=
# host:port of the Firebase emulator; bypasses credentials entirely
FIRESTORE_EMULATOR_HOST=

# --- GCS (binary template assets) --------------------------------------------
# Bucket holding template binaries (images, fonts). Firestore stores the gs://
# URIs; the bytes live here.
#   prep -> karoscmo-prep-agent-artifacts
#   prod -> karoscmo-prod-agent-artifacts
GCS_ARTIFACTS_BUCKET=karoscmo-prep-agent-artifacts

# How many few-shot examples a resolved context carries by default
DEFAULT_CONTEXT_EXAMPLE_LIMIT=10

# --- The configuration plane (Cloud SQL / Postgres) --------------------------
# S2 (SCRUM-217) put agent versions in Postgres because 40 steps x 20KB of
# prompt is 800KB against Firestore's 1MB document ceiling, and splitting a
# version into a subcollection loses the atomic write that makes it a version.
#
# UNSET IS A SUPPORTED STATE, and the reason it is worth saying: with no DSN no
# pool is built, the Configuration API's routes answer 503 naming this
# variable, the prompt store falls back to its legacy in-place write, and every
# other route is unaffected. Cloud SQL does not exist in every environment yet
# (S1 / SCRUM-216), and a control plane that refused to start without it would
# make the Postgres migration a flag day for routes that have nothing to do
# with it.
#
# From Cloud Run, connect over the Cloud SQL socket rather than a public IP --
# add the instance to the service and use:
#   postgresql://USER@/DB?host=/cloudsql/PROJECT:REGION:INSTANCE
# With IAM database authentication the user is the service account email
# without the .gserviceaccount.com suffix, and the @ in it must be percent-
# encoded, because there are two @ in the DSN and the first belongs to the name:
#   prep -> postgresql://agent-middleware-sa%40karoscmo-prep.iam@/karos-prep?host=/cloudsql/karoscmo-prep:us-central1:karos-config-prep
#   prod -> postgresql://agent-middleware-sa%40karoscmo.iam@/karos-prod?host=/cloudsql/karoscmo:europe-west1:karos-config-prod
CONFIG_DB_DSN=

# Minimum pooled connections. 1 rather than 0 so the first request after a cold
# start does not pay the connection handshake.
CONFIG_DB_POOL_MIN_SIZE=1
# Maximum pooled connections PER INSTANCE. Cloud Run multiplies this by the
# instance count against Cloud SQL's own connection limit, which is how a
# scale-out event becomes "too many connections" rather than a capacity
# increase. Raise the instance limit before raising this.
CONFIG_DB_POOL_MAX_SIZE=5
# Recycle a connection idle for longer than this. Deliberately below Cloud
# SQL's own idle timeout: a connection the server has already dropped is a
# first-request 500 that looks like a code fault.
CONFIG_DB_IDLE_LIFETIME_SECONDS=300
# Per-statement timeout. A publish validates a whole version and is the longest
# statement here; anything past this is a lock somebody else is holding.
CONFIG_DB_COMMAND_TIMEOUT_SECONDS=30

# --- Model pricing enforcement (S12 / SCRUM-222) -----------------------------
# Refuse to dispatch a run whose agent names a model the catalog cannot price.
#
# FALSE by default, and the default is the whole point: turning this on before
# scripts/seed_models.py has run against the environment turns every dispatch
# into a 422, and the way that gets noticed is a client asking why nothing ran.
#
#   1. GET /models/pricing-coverage   — what is missing right now
#   2. python scripts/seed_models.py --env prep --dry-run, then for real
#   3. confirm the gaps are gone
#   4. only then set this to true
#
# While it is false an unpriceable model is logged at WARNING with the agent and
# the stage that name it, so the gap is visible rather than silent.
MODEL_PRICING_ENFORCED=false
