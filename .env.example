# Application
APP_NAME=agent-middleware
ENVIRONMENT=local
LOG_LEVEL=INFO

# Google Cloud / Pub/Sub
GCP_PROJECT_ID=karoscmo-prep

# The one topic this service publishes to: agent-engine's run-jobs topic.
#   prep -> karos-agent-runs-prep
#   prod -> karos-agent-runs-prod
PUBSUB_JOB_TOPIC_ID=karos-agent-runs-prep

# Set to talk to a local Pub/Sub emulator instead of real GCP, e.g. localhost:8085
PUBSUB_EMULATOR_HOST=

PUBLISH_TIMEOUT_SECONDS=10

# --- Service-to-service authentication ---------------------------------------
# Verify the caller on every non-health route. Keep true everywhere but local.
AUTH_ENABLED=true

# This service's own Cloud Run URL — the 'aud' an inbound OIDC token must carry.
# REQUIRED when AUTH_ENABLED=true and no dev token is set. Without it the
# service refuses to verify tokens at all (a token with no audience bound to
# this service proves nothing; see app/security.py).
AUTH_AUDIENCE=

# Optional allowlist of caller service accounts, comma-separated JSON list, e.g.
# ["portal@karoscmo.iam.gserviceaccount.com"]. Empty admits any Google-verified
# identity, which is only safe behind Cloud Run IAM (roles/run.invoker).
AUTH_ALLOWED_SERVICE_ACCOUNTS=[]

# Static bearer token for local dev / integration tests. IGNORED when
# ENVIRONMENT=production, so leaving one set on a prod deploy is not a bypass.
AUTH_DEV_TOKEN=

# --- Authorization: who may do what ------------------------------------------
# Caller principal -> role, as a JSON object keyed by service-account email.
# The principal is the caller's `email` claim, or its `sub` when Google issued a
# token without one. Roles are ordered viewer < editor < admin:
#
#   viewer  every GET
#   editor  create, update, publish, dispatch -- the day-to-day
#   admin   anything that removes or resurrects a record, or changes whether an
#           agent may run at all (DELETE, restore, an agent's status)
#
# e.g. {"portal@karoscmo.iam.gserviceaccount.com":"editor",
#       "studio@karoscmo.iam.gserviceaccount.com":"admin"}
AUTH_ROLE_BINDINGS={}

# Role for a verified caller with no entry above, ONCE AT LEAST ONE BINDING
# EXISTS. Defaults to `viewer`, so a caller nobody bound can read and not write.
#
# HOW THIS TURNS ON, because getting it wrong takes production down. This
# service deploys with AUTH_ENABLED=true hardcoded in cloudbuild.yaml, in BOTH
# environments -- so every caller is already a verified principal here, unlike
# agent-engine where auth is still off.
#
#   AUTH_ROLE_BINDINGS empty  -> authorization is NOT enforced. Every verified
#                                caller holds admin, exactly as before roles
#                                existed. Startup logs an error saying so.
#   one or more bindings      -> enforcement is live. Bound callers get their
#                                role; everyone else gets AUTH_DEFAULT_ROLE.
#
# So migration is additive: add the portal and Studio service accounts here and
# the model starts enforcing at that moment, with no flag day. Clear the map to
# roll back. What is NOT safe is defaulting an unbound caller to `viewer` while
# the map is empty -- that would 403 every write the portal makes.
AUTH_DEFAULT_ROLE=viewer

# Firebase / Firestore (control plane store)
# Defaults to GCP_PROJECT_ID when empty.
FIRESTORE_PROJECT_ID=karoscmo
#   prep -> prep       prod -> (default)
FIRESTORE_DATABASE=prep
# Prefix every root collection, e.g. dev_ - lets environments share one database
FIRESTORE_COLLECTION_PREFIX=
# host:port of the Firebase emulator; bypasses credentials entirely
FIRESTORE_EMULATOR_HOST=

# --- GCS (the agent-engine workspace) ----------------------------------------
# Two things live in this one bucket, and the second is newer than this name:
#
#   template binaries (images, fonts) — Firestore stores the gs:// URIs
#   clients/<slug>/... — the projected client grounding an agent reads (C1)
#
# The runtime service account needs roles/storage.objectAdmin on it, in BOTH
# projects, for the client-context projection to work. A missing binding fails
# at CALL time and not at deploy time: the revision comes up healthy and the
# projection 500s the first time the portal saves a document.
#
# Unset is a supported local state: the two /clients/... routes answer 503
# naming this variable, and nothing else in the service is affected.
#   prep -> karoscmo-prep-agent-artifacts
#   prod -> karoscmo-prod-agent-artifacts
GCS_ARTIFACTS_BUCKET=karoscmo-prep-agent-artifacts

# How many few-shot examples a resolved context carries by default
DEFAULT_CONTEXT_EXAMPLE_LIMIT=10
